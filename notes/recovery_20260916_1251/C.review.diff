+    real.mkdir()
+    (real / 'DONE').write_text(audit.DONE_TEXT)
+    (tmp_path / 'alias').symlink_to(real, target_is_directory=True)
+    check = audit.Check()
+    audit.scan_dispositions(tmp_path, {'real'}, check)
+    assert check.failed()
