+            path.symlink_to(original)
+        else:
+            import os
+            os.link(original, path)
+    payload['pairs']['2'] = str(path)
+    with pytest.raises(ValueError, match='duplicate.*pair'):
+        script('mvp_score').score(payload, [locus()])
