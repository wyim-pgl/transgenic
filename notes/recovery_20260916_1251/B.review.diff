+#!/usr/bin/env python3
+"""Read-supported junction table for the B6 MVP scoring readout (exploratory).
+
+Wraps the frozen B1 evidence scorer `revision/scripts/59_evidence_support.py` —
+its SAM parsing, whole-read-group acceptance (`alignment_rejection`: primary
+only, MAPQ >= 20, supplementary/chimeric and cross-contig/strand discarded) and
+`transcript_strand` (A39 FLAG x ts:A composition) are REUSED, not reimplemented.
+Support thresholds are the scorer's frozen `THRESHOLDS`: ONT 3 / PacBio 2
+(A-HiFi counts under the PacBio threshold). Counts are READS (UMI status
+unknown; never molecules).
+
+Restriction scope (Track B must-fix 2, scope 1): a junction is tabulated only
+when its intron span lies INSIDE a panel evaluation WINDOW (30,720 nt centred
+on the gene, shared derivation `mvp_windows.evaluation_window`). The panel-GENE
+restriction applies to predicted junctions and the recall denominator in
+mvp_score.py, not here.
+
+Output TSV columns:
+    chrom  intron_start0  intron_end0  tx_strand  n_ONT  n_HiFi  supported
+Intron endpoints are 0-based inclusive; `supported` is true iff
+n_HiFi >= 2 or n_ONT >= 3. The complete-chain columns
+(chain_support_single_read / chain_callable) are added when
+59_evidence_support.py itself runs on the same BAMs (spec §2), not fabricated
+here. A QC JSON sidecar records read accept/reject counts per input.
+"""
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import sys
+from collections import Counter, defaultdict
+from pathlib import Path
+
+_SCRIPTS = Path(__file__).resolve().parents[1]
+_REPO = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(_REPO / "src"))
+
+from transgenic.evidence import mvp_windows  # noqa: E402
+
+
+def load_evidence_support():
+    path = _SCRIPTS / "59_evidence_support.py"
+    spec = importlib.util.spec_from_file_location("evidence_support_59", path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+ES = load_evidence_support()
+
+# Frozen thresholds; a drifted scorer must stop this wrapper.
+assert ES.THRESHOLDS["ONT"] == 3 and ES.THRESHOLDS["PacBio"] == 2, \
+    "frozen 59_evidence_support THRESHOLDS drifted (expected ONT 3 / PacBio 2)"
+SOURCE_THRESHOLDS = {"ONT": ES.THRESHOLDS["ONT"], "HiFi": ES.THRESHOLDS["PacBio"]}
+
+
+class JunctionTableError(ValueError):
+    pass
+
+
+def parse_alignment_spec(text):
+    parts = text.split(":", 2)
+    if len(parts) != 3 or parts[0] not in SOURCE_THRESHOLDS or \
+            parts[1] not in ("uf=true", "uf=false"):
+        raise JunctionTableError(
+            f"--alignment must be SOURCE:uf=BOOL:PATH with SOURCE in "
+            f"{sorted(SOURCE_THRESHOLDS)}; got {text!r}")
+    source, uf_text, path = parts
+    uf = uf_text == "uf=true"
+    if source == "HiFi" and uf:
+        raise JunctionTableError("HiFi (splice:hq) has no -uf mode; uf must be false")
+    return source, uf, Path(path)
+
+
+def collect_junctions(alignment_path, uf, windows, samtools="samtools"):
+    """Yield (junction_key, read_name) for accepted reads; return QC counters.
+
+    junction_key = (chrom, intron_start0, intron_end0, tx_strand) with 0-based
+    INCLUSIVE endpoints (parse_sam introns are 1-based inclusive; converted
+    here once). Junctions with unknown strand or outside every panel window are
+    counted in QC, never tabulated.
+    """
+    groups = defaultdict(list)
+    for line in ES.sam_lines(str(alignment_path), samtools):
+        aln = ES.parse_sam(line)
+        if aln is not None:
+            groups[aln.read].append(aln)
+    qc = Counter()
+    pairs = []
+    for read in sorted(groups):
+        records = groups[read]
+        rejection = ES.alignment_rejection(records)
+        if rejection:
+            qc["rejected:" + rejection] += 1
+            continue
+        aln = next(r for r in records if not r.flag & (4 | 0x900))
+        strand = ES.transcript_strand(aln, uf=uf)
+        qc["accepted_reads"] += 1
+        for start1, end1 in aln.introns:
+            start0, end0 = start1 - 1, end1 - 1
+            if strand is None:
+                qc["junctions_strand_unknown"] += 1
+                continue
+            if not mvp_windows.junction_within_windows(aln.contig, start0, end0,
+                                                       windows):
+                qc["junctions_outside_panel_windows"] += 1
+                continue
+            qc["junctions_in_panel_windows"] += 1
+            pairs.append(((aln.contig, start0, end0, strand), read))
+    qc["raw_reads"] = len(groups)
+    return pairs, qc
+
+
+def build_table(alignments, windows, samtools="samtools"):
+    reads_by_source = {source: defaultdict(set) for source in SOURCE_THRESHOLDS}
+    qc = {}
+    seen = set()
+    for source, uf, path in alignments:
+        identity = Path(path).resolve()
+        if identity in seen:
+            raise JunctionTableError("duplicate alignment input")
+        seen.add(identity)
+        pairs, counters = collect_junctions(path, uf, windows, samtools)
+        for key, read in pairs:
+            reads_by_source[source][key].add((str(path), read))
+        qc[f"{source}:{path}"] = dict(sorted(counters.items()))
+    keys = sorted(set(reads_by_source["ONT"]) | set(reads_by_source["HiFi"]))
+    rows = []
+    for key in keys:
+        n_ont = len(reads_by_source["ONT"].get(key, ()))
+        n_hifi = len(reads_by_source["HiFi"].get(key, ()))
+        supported = (n_hifi >= SOURCE_THRESHOLDS["HiFi"]
+                     or n_ont >= SOURCE_THRESHOLDS["ONT"])
+        chrom, start0, end0, strand = key
+        rows.append({"chrom": chrom, "intron_start0": start0, "intron_end0": end0,
+                     "tx_strand": strand, "n_ONT": n_ont, "n_HiFi": n_hifi,
+                     "supported": supported})
+    return rows, qc
+
+
+HEADER = ("chrom", "intron_start0", "intron_end0", "tx_strand",
+          "n_ONT", "n_HiFi", "supported")
+
+
+def write_table(rows, out_path):
+    with open(out_path, "w") as f:
+        f.write("\t".join(HEADER) + "\n")
+        for row in rows:
+            f.write("\t".join(str(row[c]).lower() if c == "supported"
+                              else str(row[c]) for c in HEADER) + "\n")
+
+
+def read_table(path):
+    """Load a table written by write_table, fail-closed on schema drift."""
+    rows = []
+    with open(path) as f:
+        header = tuple(f.readline().rstrip("\n").split("\t"))
+        if header != HEADER:
+            raise JunctionTableError(f"junction table header mismatch: {header!r}")
+        for line in f:
+            fields = line.rstrip("\n").split("\t")
+            if len(fields) != len(HEADER):
+                raise JunctionTableError("junction table row width mismatch")
+            if fields[6] not in ("true", "false"):
+                raise JunctionTableError("supported must be true/false")
+            rows.append({"chrom": fields[0], "intron_start0": int(fields[1]),
+                         "intron_end0": int(fields[2]), "tx_strand": fields[3],
+                         "n_ONT": int(fields[4]), "n_HiFi": int(fields[5]),
+                         "supported": fields[6] == "true"})
+    keys = set()
+    for row in rows:
+        key = tuple(row[c] for c in HEADER[:4])
+        if (key in keys or row['tx_strand'] not in ('+', '-') or
+                not 0 <= row['intron_start0'] <= row['intron_end0'] or
+                min(row['n_ONT'], row['n_HiFi']) < 0 or
+                row['supported'] != (row['n_ONT'] >= 3 or row['n_HiFi'] >= 2)):
+            raise JunctionTableError('invalid, duplicate, or inconsistent junction row')
+        keys.add(key)
+    return rows
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--alignment", action="append", required=True,
+                        metavar="SOURCE:uf=BOOL:PATH",
+                        help="repeatable; SOURCE is ONT or HiFi; uf must state "
+                             "the audited -uf decision explicitly")
+    parser.add_argument("--panels", required=True, type=Path)
+    parser.add_argument("--out", required=True, type=Path)
+    parser.add_argument("--qc-out", required=True, type=Path)
+    parser.add_argument("--samtools", default="samtools")
+    args = parser.parse_args(argv)
+
+    expected = mvp_windows.PANEL_SHA256
+    loci = mvp_windows.load_panel(args.panels, expected_sha256=expected)
+    windows = mvp_windows.windows_by_chromosome(loci)
+    alignments = [parse_alignment_spec(text) for text in args.alignment]
+    rows, qc = build_table(alignments, windows, args.samtools)
+    write_table(rows, args.out)
+    qc_report = {
+        "panel_sha256": expected,
+        "panel_sha256_is_frozen": expected == mvp_windows.PANEL_SHA256,
+        "thresholds": SOURCE_THRESHOLDS,
+        "counts_are": "reads (UMI status unknown; never molecules)",
+        "scorer": "59_evidence_support.py (sha256 "
+                  + hashlib.sha256((_SCRIPTS / "59_evidence_support.py")
+                                   .read_bytes()).hexdigest() + ")",
+        "restriction": "junction contained in a 30,720-nt panel evaluation window",
+        "per_input": qc,
+        "junctions": len(rows),
+        "supported_junctions": sum(r["supported"] for r in rows),
+    }
+    args.qc_out.write_text(json.dumps(qc_report, indent=1, sort_keys=True) + "\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/revision/scripts/mvp/mvp_score.py b/revision/scripts/mvp/mvp_score.py
new file mode 100644
index 0000000..aeac02a
--- /dev/null
+++ b/revision/scripts/mvp/mvp_score.py
@@ -0,0 +1,155 @@
+#!/usr/bin/env python3
+"""CPU MVP statistics from caller-supplied counts and final eval-pair JSONL.
+
+Input JSON: pairs maps '1','2','3' to final deduplicated JSONL paths; loci is
+50 records {gene_id, seeds: {'1': {'off': counts, 'on': counts}, ...}}.
+counts: f1_tp, f1_predicted, f1_reference (GFFCompare v0.12.6 restricted
+transcript counts; monoexonic exact CDS), and optionally precision_tp,
+predicted, recall_tp, supported (exact junction counts). All are integers.
+Structural counts must be present everywhere or nowhere, never filled as zero
+for missing evidence. F1 is percentage points; P/R are fractions.
+This adapter does not decode models or claim to run GFFCompare.
+"""
+import argparse
+import json
+import math
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[3] / 'src'))
+from transgenic.evidence import mvp_bootstrap as b, mvp_windows as w
+
+
+def require_coverage_policy(policy):
+    # No policy is approved in this implementation. A future author-approved
+    # policy must specify technology/run coverage before decision publication.
+    raise ValueError('coverage policy pending author approval (HiFi versus ONT-only)')
+
+
+def predicted_junctions(transcripts, locus):
+    """Normalized decoded transcripts: chrom, strand, half-open exon intervals.
+
+    Select by transcript-span overlap with the gene, then retain ALL introns.
+    No strand-based overlap filter: wrong-strand predictions stay penalized.
+    """
+    genes = w.genes_by_chromosome([locus])
+    result = set()
+    for tx in transcripts:
+        exons = sorted(tx['exons'])
+        if (not exons or tx['strand'] not in ('+', '-') or
+                any(type(a) is not int or type(z) is not int or not 0 <= a < z for a, z in exons) or
+                any(a[1] >= z[0] for a, z in zip(exons, exons[1:]))):
+            raise ValueError('invalid transcript exons/strand')
+        if w.transcript_overlaps_gene(tx['chrom'], exons[0][0], exons[-1][1] - 1, genes):
+            result.update((tx['chrom'], a[1], z[0] - 1, tx['strand']) for a, z in zip(exons, exons[1:]))
+    return result
+
+
+def junction_counts(predicted, supported, locus):
+    """Predicted set already selected by transcript-overlaps-gene, not clipped."""
+    if supported is None:
+        return None
+    windows = w.windows_by_chromosome([locus])
+    supported = {j for j in supported if w.junction_within_windows(*j[:3], windows)}
+    genes = w.genes_by_chromosome([locus])
+    recall = {j for j in supported if w.junction_within_genes(*j[:3], genes)}
+    return dict(predicted=len(predicted), precision_tp=len(predicted & supported),
+                supported=len(recall), recall_tp=len(predicted & recall))
+
+
+def metric(rows, fraction, name, seeds=(1, 2, 3)):
+    counts = [r['seeds'][str(s)][fraction] for r in rows for s in seeds]
+    total = lambda key: sum(c[key] for c in counts)
+    if name == 'F1':
+        denominator = total('f1_predicted') + total('f1_reference')
+        return 200 * total('f1_tp') / denominator if denominator else float('nan')
+    numerator, denominator = ('precision_tp', 'predicted') if name == 'P' else ('recall_tp', 'supported')
+    d = total(denominator)
+    return total(numerator) / d if d else float('nan')
+
+
+def score(payload, panel):
+    if set(payload['pairs']) != {'1', '2', '3'}:
+        raise ValueError('exact seeds 1, 2, 3 required')
+    records = {int(s): [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
+               for s, path in payload['pairs'].items()}
+    rns, delta = b.build_tiles(records)
+    primary = b.tile_bootstrap(delta)
+    composite = math.fsum(r['composite_loss_off'] - r['composite_loss_on']
+                         for rows in records.values() for r in rows if r['has_evidence']) / (3 * len(rns))
+    loci = payload['loci']
+    ids = [r['gene_id'] for r in loci]
+    if len(ids) != len(set(ids)) or set(ids) != {l.gene_id for l in panel}:
+        raise ValueError('exact full panel locus inventory required')
+    loci = sorted(loci, key=lambda r: r['gene_id'])
+    structural_flags = []
+    for row in loci:
+        if set(row['seeds']) != {'1', '2', '3'}:
+            raise ValueError('each locus must carry all three seeds')
+        for pair in row['seeds'].values():
+            if set(pair) != {'off', 'on'}:
+                raise ValueError('paired fractions off/on required')
+            for c in pair.values():
+                required = {'f1_tp', 'f1_predicted', 'f1_reference'}
+                structural = {'precision_tp', 'predicted', 'recall_tp', 'supported'}
+                if set(c) not in (required, required | structural):
+                    raise ValueError('count schema mismatch')
+                if any(type(v) is not int or v < 0 for v in c.values()):
+                    raise ValueError('counts must be nonnegative integers')
+                if c['f1_tp'] > min(c['f1_predicted'], c['f1_reference']):
+                    raise ValueError('F1 numerator exceeds denominator')
+                available = structural <= set(c)
+                structural_flags.append(available)
+                if available and (c['precision_tp'] > c['predicted'] or c['recall_tp'] > c['supported']):
+                    raise ValueError('junction numerator exceeds denominator')
+            if pair['off']['f1_reference'] != pair['on']['f1_reference']:
+                raise ValueError('reference denominator differs between fractions')
+            if 'supported' in pair['off'] and 'supported' in pair['on'] and pair['off']['supported'] != pair['on']['supported']:
+                raise ValueError('structural denominator differs between fractions')
+    if any(structural_flags) != all(structural_flags):
+        raise ValueError('partially missing structural scoring; do not encode missing as negative')
+    result = dict(label='exploratory / MVP', panel_sha256=w.PANEL_SHA256,
+                  primary=primary, composite_delta_diagnostic=composite,
+                  structural_available=all(structural_flags), readouts={},
+                  training_eligible=False,
+                  decision=None, decision_status='BLOCKED_PENDING_COVERAGE_POLICY',
+                  precision_rule='point_estimate_ge_0; interpretation pending author review')
+    core = {l.gene_id for l in panel if l.panel == 'mvp_core'}
+    for stratum, rows in [('all50', loci), ('core20', [r for r in loci if r['gene_id'] in core])]:
+        result['readouts'][stratum] = {}
+        for name in ['F1'] + (['P', 'R'] if all(structural_flags) else []):
+            by_seed = {}
+            for label, seeds in [('pooled', (1, 2, 3)), ('1', (1,)), ('2', (2,)), ('3', (3,))]:
+                try:
+                    by_seed[label] = b.locus_bootstrap(rows, lambda sample: metric(sample, 'on', name, seeds) - metric(sample, 'off', name, seeds))
+                except b.BootstrapError as e:
+                    by_seed[label] = {'status': 'UNASSESSABLE', 'reason': str(e)}
+            result['readouts'][stratum][name] = by_seed
+    return result
+
+
+def main(argv=None):
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--input', required=True, type=Path)
+    p.add_argument('--panels', required=True, type=Path)
+    p.add_argument('--out', required=True, type=Path)
+    p.add_argument('--final-decision', action='store_true', help='currently fail-closed pending author policy')
+    a = p.parse_args(argv)
+    if a.final_decision:
+        require_coverage_policy(None)
+    input_hash = w.sha256_file(a.input)
+    payload = json.loads(a.input.read_text())
+    hashes = {str(path): w.sha256_file(path) for path in [a.panels, *payload['pairs'].values()]}
+    hashes[str(a.input)] = input_hash
+    result = score(payload, w.load_panel(a.panels))
+    if any(w.sha256_file(path) != expected for path, expected in hashes.items()):
+        raise ValueError('scoring input changed during computation')
+    result['input_sha256'] = hashes
+    result['count_provenance_status'] = 'caller-supplied counts; not independently verified by this adapter'
+    with a.out.open('x') as f:
+        json.dump(result, f, indent=2, allow_nan=False)
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
