+
+```
+/ABS/PYTHON -m accelerate.commands.launch --multi_gpu --num_machines 1 \
+  --num_processes 4 --mixed_precision bf16 \
+  --config_file /work/repo/revision/scripts/mvp/accelerate_mvp.json --max_restarts 0 \
