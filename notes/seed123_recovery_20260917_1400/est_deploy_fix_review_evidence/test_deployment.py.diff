+    def term_probe(self, phase):
+        self.build()
+        ready = self.root / 'ready'
+        finalizing = self.root / 'finalizing'
+        script = '''
+import importlib.util, sys, time
+from pathlib import Path
+spec = importlib.util.spec_from_file_location('runner', sys.argv[1])
+r = importlib.util.module_from_spec(spec); spec.loader.exec_module(r)
+phase, ready, finalizing = sys.argv[5], Path(sys.argv[6]), Path(sys.argv[7])
+calls = 0
+def runtime(manifest):
+    global calls
+    calls += 1
+    if phase in ('before', 'after') and calls == (1 if phase == 'before' else 2):
+        ready.write_text('ready')
+        time.sleep(10)
+    return {'fixture': True}
+r.runtime_identity = runtime
+original = r.write_json
+def write(path, value):
+    original(path, value)
+    target = 'verification.json' if phase == 'verification' else 'result.json'
+    if path.name == target:
+        if phase in ('receipt', 'verification'):
+            ready.write_text('ready')
+        finalizing.write_text('ready')
+        time.sleep(.3)
+r.write_json = write
+sys.exit(r.run(Path(sys.argv[2]), sys.argv[3], Path(sys.argv[4])))
+'''
+        child = subprocess.Popen([sys.executable, '-B', '-c', script, str(HERE / 'run_compute.py'),
+                                  str(self.release), self.sha, str(self.root / 'output'), phase,
+                                  str(ready), str(finalizing)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        def wait_for(path):
+            deadline = time.monotonic() + 5
+            while not path.exists() and child.poll() is None and time.monotonic() < deadline:
+                time.sleep(.01)
+            self.assertTrue(path.exists(), 'child did not reach ' + path.name)
+        try:
+            wait_for(ready)
+            child.send_signal(signal.SIGTERM)
+            wait_for(finalizing)
+            for _ in range(3):
+                child.send_signal(signal.SIGTERM)
+                time.sleep(.02)
+            stdout, stderr = child.communicate(timeout=5)
+            self.assertNotEqual(child.returncode, 0, (stdout, stderr))
+            self.assertGreater(child.returncode, 0, stderr)
+            control = self.root / 'output/control'
+            self.assertEqual(json.loads((control / 'start.json').read_text())['status'], 'INCOMPLETE')
+            result = json.loads((control / 'result.json').read_text())
+            self.assertEqual(result['status'], 'INCOMPLETE')
+            self.assertTrue(result['interrupted'])
+            self.assertFalse((control / 'verification.json').exists())
+            self.assertEqual((self.root / 'output/sample/COMPLETE').exists(), phase != 'before')
+        finally:
+            if child.poll() is None:
+                child.kill()
+            child.communicate(timeout=5)
+
