+    def test_batch_forwards_once_and_enforces_grace_deadline(self):
+        self.build()
+        ready = self.root / 'ready'
+        terms = self.root / 'terms'
+        child_script = self.root / 'child.py'
+        child_script.write_text('import signal, sys, time\nfrom pathlib import Path\n'
+                                'def term(sig, frame):\n    with Path(' + repr(str(terms)) + ').open("a") as f: f.write("TERM\\n")\n'
+                                'signal.signal(signal.SIGTERM, term)\n'
+                                'signal.signal(signal.SIGUSR1, lambda sig, frame: sys.exit(7))\n'
+                                'Path(' + repr(str(ready)) + ').touch()\ntime.sleep(10)\n')
+        batch = (HERE / 'sample.sbatch').read_text()
+        batch = batch.replace(self.runner.PYTHON, sys.executable)
+        batch = batch.replace('"$release/run_compute.py"', str(child_script))
+        batch = batch.replace('sleep 40', 'sleep .3')
+        script = self.root / 'fixture.sbatch'; script.write_text(batch)
+        with (self.root / 'stdout').open('wb') as stdout, (self.root / 'stderr').open('wb') as stderr:
+            child = subprocess.Popen(['/bin/bash', str(script), str(self.release), self.sha,
+                                      str(self.root / 'unused-output')], stdout=stdout, stderr=stderr,
+                                     env=dict(os.environ, SLURM_JOB_ID='fixture'), start_new_session=True)
+            try:
+                deadline = time.monotonic() + 5
+                while not ready.exists() and child.poll() is None and time.monotonic() < deadline:
+                    time.sleep(.01)
+                self.assertTrue(ready.exists())
+                for _ in range(3):
+                    child.send_signal(signal.SIGTERM); time.sleep(.03)
+                self.assertEqual(child.wait(timeout=3), 7)
+                self.assertEqual(terms.read_text(), 'TERM\n')
+            finally:
+                if child.poll() is None:
+                    os.killpg(child.pid, signal.SIGKILL)
+                    child.wait(timeout=3)
