FUNCTORCH [('enable_autograd_cache', True), ('autograd_cache_allow_custom_autograd_functions', False), ('bundled_autograd_cache', False), ('bypass_autograd_cache_key', False), ('autograd_cache_normalize_inputs', True), ('enable_remote_autograd_cache', None), ('strict_autograd_cache', False), ('force_autograd_cache', False)]
